<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in</title>
<style>
body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #f4f5f7; margin: 0; }
form { background: #fff; width: 320px; margin: 12vh auto 0; padding: 32px; border: 1px solid #dfe1e6; border-radius: 4px; }
h1 { font-size: 20px; font-weight: 600; margin: 0 0 24px; }
label { display: block; font-size: 13px; margin: 12px 0 4px; color: #42526e; }
input[type=text], input[type=password] { width: 100%; box-sizing: border-box; padding: 8px; border: 1px solid #c1c7d0; border-radius: 3px; }
input[type=submit] { margin-top: 20px; width: 100%; padding: 9px; border: 0; border-radius: 3px; background: #0052cc; color: #fff; font-weight: 600; }
.error { color: #bf2600; font-size: 13px; margin: 0 0 8px; }
</style>
</head>
<body>
<form method="POST" action="/index.html">
<h1>Sign in</h1>
<!--STARTERR-->
<p class="error">Invalid username or password.</p>
<!--ENDERR-->
<label for="username">Username</label>
<input type="text" id="username" name="username" autocomplete="username">
<label for="password">Password</label>
<input type="password" id="password" name="password" autocomplete="current-password">
<input type="submit" value="Sign in">
</form>
</body>
</html>
