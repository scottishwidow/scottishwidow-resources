HostKey /etc/ssh/ssh_host_ed25519_key
HostKeyAlgorithms ssh-ed25519

KexAlgorithms {{ ssh_hardening_kex_algorithms | join(',') }}
Ciphers {{ ssh_hardening_ciphers | join(',') }}
MACs {{ ssh_hardening_macs | join(',') }}

PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers {{ ssh_hardening_allow_users | join(' ') }}
MaxAuthTries 3
LoginGraceTime 20

X11Forwarding no
AllowAgentForwarding no
PermitTunnel no
AllowTcpForwarding {{ ssh_hardening_allow_tcp_forwarding }}
