[Unit]
Description=Sinkhole DNS

# The image runs CoreDNS as an unprivileged uid, so it listens on the Sinkhole
# port in the container as well.
[Container]
ContainerName=sinkhole-dns
Image={{ sinkhole_coredns_image }}
Exec=-conf /etc/coredns/Corefile
Network=pasta
PublishPort={{ sinkhole_listen_ip }}:{{ sinkhole_dns_port }}:{{ sinkhole_dns_port }}/udp
PublishPort={{ sinkhole_listen_ip }}:{{ sinkhole_dns_port }}:{{ sinkhole_dns_port }}/tcp
Volume={{ sinkhole_dns_directory }}/Corefile:/etc/coredns/Corefile:ro
ReadOnly=true
NoNewPrivileges=true
LogDriver=journald

# The first start pulls the image. The private IP arrives over DHCP, and a
# user unit cannot wait for the system network-online.target, so a start
# before the address exists fails and is tried again.
[Service]
TimeoutStartSec=300
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
