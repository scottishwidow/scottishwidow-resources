[Unit]
Description=Update the Suricata rules
Wants=network-online.target
After=network-online.target suricata.service
Requisite=suricata.service

[Service]
Type=oneshot
User={{ suricata_user }}
Group={{ suricata_group }}
ExecStart=/usr/bin/suricata-update --reload-command "/usr/bin/suricatasc -c reload-rules"
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ suricata_owned_directories | join(' ') }}
