[Unit]
Description=Update the Suricata rules
Wants=network-online.target
After=network-online.target suricata.service
Requisite=suricata.service

[Service]
# suricata-update tests the new rules with suricata -T and keeps the old rules
# when the test fails. It runs the reload command only when the rules change.
# Suricata loads the rules again in place, so the capture does not stop.
Type=oneshot
User={{ suricata_user }}
Group={{ suricata_group }}
ExecStart=/usr/bin/suricata-update --reload-command "/usr/bin/suricatasc -c reload-rules"
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ suricata_owned_directories | join(' ') }}
