[Service]
RuntimeDirectory=suricata
RuntimeDirectoryMode=0750
PIDFile={{ suricata_pid_file }}
ExecStartPre=
ExecStartPre=/bin/rm -f {{ suricata_pid_file }}
ExecStartPre=/bin/chown {{ suricata_user }}:{{ suricata_group }} /run/suricata
ExecStart=
ExecStart=/usr/bin/suricata {{ suricata_capture_arguments[suricata_mode] }} -c /etc/suricata/suricata.yaml --pidfile {{ suricata_pid_file }}
