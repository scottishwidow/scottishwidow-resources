%YAML 1.1
---
vars:
  address-groups:
    HOME_NET: "[{{ suricata_home_net }}]"
    EXTERNAL_NET: "!$HOME_NET"
    HTTP_SERVERS: "$HOME_NET"
    SMTP_SERVERS: "$HOME_NET"
    SQL_SERVERS: "$HOME_NET"
    DNS_SERVERS: "$HOME_NET"
    TELNET_SERVERS: "$HOME_NET"
    AIM_SERVERS: "$EXTERNAL_NET"
    DC_SERVERS: "$HOME_NET"
    DNP3_SERVER: "$HOME_NET"
    DNP3_CLIENT: "$HOME_NET"
    MODBUS_SERVER: "$HOME_NET"
    MODBUS_CLIENT: "$HOME_NET"
    ENIP_SERVER: "$HOME_NET"
    ENIP_CLIENT: "$HOME_NET"
  port-groups:
    HTTP_PORTS: "80"
    SHELLCODE_PORTS: "!80"
    ORACLE_PORTS: 1521
    SSH_PORTS: 22
    DNP3_PORTS: 20000
    MODBUS_PORTS: 502
    FILE_DATA_PORTS: "[$HTTP_PORTS,110,143]"
    FTP_PORTS: 21
    GENEVE_PORTS: 6081
    VXLAN_PORTS: 4789
    TEREDO_PORTS: 3544

default-log-dir: /var/log/suricata

# Suricata turns these parsers off by default, so their rules fail to load.
# suricata-update disables the rules of a protocol only when the config turns it
# off, and the config test of suricata-update fails on a rule that cannot load.
app-layer:
  protocols:
    modbus:
      enabled: no
    dnp3:
      enabled: no

outputs:
  - eve-log:
      enabled: true
      filetype: regular
      filename: eve.json
      # TODO: add mysql when the PPA ships a Suricata with a MySQL parser.
      # Suricata 8.0 has no such parser, and the config test fails on the type.
      types:
        - alert
        - anomaly
        - http
        - dns
        - tls
        - ssh
        - smb
        - ftp
        - flow

  # In normal mode all threads share one file, so max-files bounds the whole
  # ring buffer and not each thread. A file name that holds only the second
  # repeats when two files open in the same second, and the newer file then
  # overwrites the older one.
  - pcap-log:
      enabled: true
      filename: log.pcap
      mode: normal
      conditional: alerts
      limit: {{ suricata_pcap_file_size_limit }}
      max-files: {{ suricata_pcap_max_files }}
      compression: none
      ts-format: usec

logging:
  default-log-level: notice
  outputs:
    - console:
        enabled: false
    - file:
        enabled: true
        filename: /var/log/suricata/suricata.log

af-packet:
  - interface: {{ suricata_private_interface }}
    cluster-id: 99
    cluster-type: cluster_flow
    defrag: true

nfq:
  mode: accept
  fail-open: true

# ExecStop of the packaged service calls suricatasc, which needs this socket.
# systemd owns the directory, so the path follows RuntimeDirectory of the
# service and matches the default that suricatasc assumes.
unix-command:
  enabled: true
  filename: /run/suricata/suricata-command.socket

default-rule-path: /var/lib/suricata/rules
rule-files:
  - suricata.rules
  - {{ suricata_local_rules_path }}

classification-file: /etc/suricata/classification.config
reference-config-file: /etc/suricata/reference.config
