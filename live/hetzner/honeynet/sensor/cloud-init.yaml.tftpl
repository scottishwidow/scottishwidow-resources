#cloud-config
users:
  - name: admin
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${admin_ssh_public_key}

# The netplan from cloud-init configures eth0 only, so nothing brings up the
# private interface. Its DHCP routes are ignored to keep the default route on
# eth0, and the Honeynet range goes to the Hetzner network gateway.
write_files:
  - path: /etc/systemd/network/05-honeynet.network
    owner: root:root
    permissions: "0644"
    content: |
      [Match]
      Name=en*

      [Network]
      DHCP=ipv4

      [DHCPv4]
      UseDNS=no
      UseGateway=no
      UseRoutes=no

      [Route]
      Destination=${network_ip_range}
      Gateway=${network_gateway_ip}
      GatewayOnLink=yes

  - path: /etc/ssh/sshd_config.d/10-port.conf
    owner: root:root
    permissions: "0644"
    content: |
      Port ${admin_ssh_port}

  - path: /etc/sysctl.d/90-sensor-forwarding.conf
    owner: root:root
    permissions: "0644"
    content: |
      net.ipv4.ip_forward = 1

  - path: /etc/nftables.conf
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/sbin/nft -f
      flush ruleset

      define honeynet = ${network_ip_range}
      define sensor_public_ipv4 = ${public_ipv4}
      define sensor_private_ip = ${sensor_private_ip}
      define honeypot = ${honeypot_ip}

      table inet filter {
        # The prerouting chain sends Honeypot HTTP, HTTPS and DNS to the
        # Sinkhole on this host. Its flows are queued like the forwarded ones.
        chain input {
          type filter hook input priority filter; policy drop;
          iif "lo" accept
          ip saddr $honeynet ct status dnat queue num 0 bypass
          ct state established,related accept
          ct state invalid drop
          ip protocol icmp accept
          tcp dport ${admin_ssh_port} accept
          ip saddr $honeynet tcp dport ${proxy_port} accept
          ${indent(10, sinkhole_input_rules)}
        }

        # Containment comes first, so no later rule can let a new connection
        # leave the Honeynet. The queue rule comes before the established
        # rule, so that in IPS mode Suricata gets every packet of a flow and
        # not only the first one.
        chain forward {
          type filter hook forward priority filter; policy drop;
          ip saddr $honeynet ip daddr != $honeynet ct state new counter drop
          ct status dnat queue num 0 bypass
          ct state established,related accept
        }

        chain output {
          type filter hook output priority filter; policy accept;
        }
      }

      # The Honeypots' replies need no masquerade: conntrack reverses the
      # DNAT, so they leave with the Sensor public IPv4 as the source. The
      # Sinkhole DNAT keeps Honeypot HTTP, HTTPS and DNS inside the Honeynet.
      # When nothing listens on a Sinkhole port, the Sensor refuses the
      # connection.
      table ip nat {
        chain prerouting {
          type nat hook prerouting priority dstnat; policy accept;
          ${indent(10, dnat_rules)}
        }
      }

# Ubuntu 24.04 starts sshd through ssh.socket, which listens on port 22 until
# it is regenerated. Plain ssh.service reads the port from sshd_config.
runcmd:
  - systemctl restart systemd-networkd.service
  - sysctl --system
  - systemctl enable --now nftables.service
  - systemctl disable --now ssh.socket
  - rm -f /etc/systemd/system/ssh.service.d/00-socket.conf /etc/systemd/system/ssh.socket.d/addresses.conf
  - systemctl daemon-reload
  - systemctl enable ssh.service
  - systemctl restart ssh.service
